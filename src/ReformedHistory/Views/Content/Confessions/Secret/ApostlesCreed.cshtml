@model ReformedHistory.Views.Content.Confessions.Secret.SecretSection

<h2 id="@this.Model.Link">Chapter @this.Model.Index</h2>
<h3>@this.Model.Name</h3>
<br />

<div class="centerQuote">
    <span>
        The catholic faith is not given to us by human laws, but by Holy Scriptures, 
        of which the Apostles' Creed is a compendium.
    </span>
    <span>Heinrich Bullinger, The Second Helvetic Confession</span>
</div>
    
<p>
    <b>We believe</b> in God, the Father almighty, <br />
    <span class="tab"></span> creator of heaven and earth. <br />
    <br />

    <b>We believe</b> in Jesus Christ, his only Son, our Lord, <br />
    <span class="tab"></span> who was conceived by the Holy Spirit <br />
    <span class="tab"></span> and born of the virgin Mary. <br />
    <span class="tab"></span> He suffered under Pontius Pilate, <br />
    <span class="tab"></span> was crucified, died, and was buried; <br />
    <span class="tab"></span> he descended to hell. <br />
    <span class="tab"></span> The third day he rose again from the dead. <br />
    <span class="tab"></span> He ascended to heaven <br />
    <span class="tab"></span> and is seated at the right hand of God the Father almighty. <br />
    <span class="tab"></span> From there he will come to judge the living and the dead. <br />
    <br />

    <b>We believe</b> in the Holy Spirit, <br />
    <span class="tab"></span> the holy catholic church, <br />
    <span class="tab"></span> the communion of saints, <br />
    <span class="tab"></span> the forgiveness of sins, <br />
    <span class="tab"></span> the resurrection of the body, <br />
    <span class="tab"></span> and the life everlasting. Amen.
</p>
<br />