@model ReformedHistory.Views.Content.Confessions.Secret.SecretSection

<h2 id="@this.Model.Link">Chapter @this.Model.Index</h2>
<h3>@this.Model.Name</h3>
<br />

<div class="centerQuote">
    <span>
        God is light, and in Him is no darkness at all
    </span>
    <span>Saint John, First Epistle</span>
</div>
    
<ol>
    <li>
        The Lord God is righteous and holy, a God of faithfulness and without iniquity, 
        perfect in all of His works. There is none holy like the Lord, and none besides Him
        <a href="#RighteousnessOfGod.Sources.1">(@(this.Model.Index).1)</a>
    </li>
    <li>
        Sinful man cannot stand before the Lord, for He is an all-consuming fire
        that obliterates wickedness and pours out His wrath on injustice.
    </li>
    <li>
        But in these last days the righeousness of God has been revealed in Jesus Christ, 
        so that all who are united to Christ by faith might become the very righteousness of God
        <a href="#RighteousnessOfGod.Sources.3">(@(this.Model.Index).3)</a>
    </li>
</ol>
<br />