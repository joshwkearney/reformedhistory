@section DocumentDetails {
}

@section Title {
    <h1>A Reformed Catholic Confession</h1>
    <h3>Written by Joshua Kearney as a private devotion</h3>
}

@section DocumentContent {
    <style>
        ul {
            list-style: circle;
            list-style-position: inside;
        }
        
        .tab {
            padding-left: 2rem;
        }
        
        b {
            font-weight: bold;
        }
        
        i {
            font-style: italic;
        }
        
        blockquote > cite {
            text-align: right !important;
        }
        
        .centerQuote {
            font-style: italic;
            display: block;
            align-content: center;
            padding-left:  2rem;
            padding-right:  3rem;
            margin-bottom:  2rem;
            margin-top:  0.5rem;
            line-height: 20pt;
            text-align: justify;
            
            span:first-child:before {
                content: "“";
                font-size: 25pt;
                font-family: 'times new roman';
                vertical-align: middle;
                line-height: 20pt;
            }

            span:first-child:after {
                content: "”";
                font-size: 25pt;
                font-family: 'times new roman';
                vertical-align: middle;
                line-height: 20pt;
            }
            
            span:nth-child(2) {
                display: block;
                text-align: right;
                margin-top: 0.5rem;
            }

            span:nth-child(2):before {
                content: '— ';
            }
        }
    </style>
    
    @foreach (var item in sections) {
        if (!string.IsNullOrWhiteSpace(item.View)) {
            <partial name="@item.View" model="@item"/>
        }
    }
    
