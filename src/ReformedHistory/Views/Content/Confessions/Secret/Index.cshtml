@section DocumentNavigation {
    <h1>Table of Contents</h1>

    <ol>
        @foreach (var item in sections) {
            <li>
                <a href="#@item.Link">@item.Name</a>

                @if (item.GroupEnd) {
                    <br/> <br/>
                }
            </li>
        }
        
