@model ReformedHistory.Views.Content.Confessions.Secret.SecretSection

<h2 id="@this.Model.Link">Chapter @this.Model.Index</h2>
<h3>@this.Model.Name</h3>
<br />

<div class="centerQuote">
    <span>
        What can be a more spiritual prayer than that which was given to us by Christ, by 
        whom the Holy Spirit was also given to us? What prayer to the Father can be more 
        truthful than that which was delivered to us by the Son, who is the truth, out of 
        His own mouth?
    </span>
    <span>Saint Cyprian of Carthage, Treatise IV</span>
</div>
    
<p>
    Our Father, <br />
    <span class="tab"></span> who art in heaven, <br />
    <span class="tab"></span>hallowed be thy name; <br />
    <span class="tab"></span>thy kingdom come; <br />
    <span class="tab"></span>thy will be done; <br />
    <span class="tab"></span>on earth as it is in heaven. <br />
    <br />
    
    Give us this day our daily bread. <br />
    <span class="tab"></span>And forgive us our trespasses, <br />
    <span class="tab"></span>as we forgive those who trespass against us. <br />
    <br />
    
    And lead us not into temptation; <br />
    <span class="tab"></span>but deliver us from evil. <br />
    <br />
    
    For thine is the kingdom, <br />
    <span class="tab"></span>the power and the glory, <br />
    <span class="tab"></span>for ever and ever. Amen.
</p>
<br />